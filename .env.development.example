# Copy to .env.development for local work:
#   cp .env.development.example .env.development

NODE_ENV=development

# Server
PORT=4044

# MongoDB (local or Atlas)
MONGO_URL=mongodb://127.0.0.1:27017/ExpenseApp

# Auth
JWT_SECRET=dev_secret_change_me
JWT_EXPIRES_IN=7d

# CORS (comma-separated — include deployed fronts if you hit a remote API from local)
CORS_ORIGIN=http://localhost:4043,https://spendwise-seven-alpha.vercel.app,https://spendwise.abhiiiijain.com

# API
API_PREFIX=/api/v1

# Auth rate limiting
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Logging: debug | info | warn | error
LOG_LEVEL=debug

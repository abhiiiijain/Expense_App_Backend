# Copy to .env.production for local prod testing, or set the same keys in Render:
#   cp .env.production.example .env.production
#
# On Render, prefer Dashboard env vars — this file is optional and must never be committed.

NODE_ENV=production

# Render sets PORT automatically; only needed for local production runs
PORT=10000

# MongoDB Atlas
MONGO_URL=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/ExpenseApp

# Auth — use a long random secret in production
JWT_SECRET=replace_with_long_random_secret
JWT_EXPIRES_IN=7d

# CORS — deployed frontend origin(s), comma-separated
CORS_ORIGIN=https://spendwise-seven-alpha.vercel.app,https://spendwise.abhiiiijain.com

# API
API_PREFIX=/api/v1

# Auth rate limiting
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Logging: debug | info | warn | error
LOG_LEVEL=info
